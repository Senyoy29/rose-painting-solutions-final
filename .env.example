# Where the contact form sends enquiries. Works with Formspree, Getform,
# Basin or any endpoint that accepts a JSON POST and returns 2xx.
# Example: VITE_FORM_ENDPOINT=https://formspree.io/f/abcdwxyz
# This value is public (it ships in the browser bundle) — never put API
# secrets or passwords in a VITE_ variable.
VITE_FORM_ENDPOINT=
